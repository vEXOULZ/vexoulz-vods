# All optional. See src/vods.config.ts.
# Archive API base URL used by the app (default: /backend on the same origin).
VITE_ARCHIVE_API=/backend
# Where `npm run dev` forwards /backend to (default: the public vods site).
VITE_DEV_API_TARGET=https://vods.example.net
# Admin API base used by /admin (default: /backend-admin on the same origin).
VITE_ADMIN_API=/backend-admin
# Where `npm run dev` forwards /backend-admin to. Unset: a built-in mock (password "admin"). Keep real values in
# .env.local, never in this file.
VITE_DEV_ADMIN_TARGET=
