{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>vexouLuna/conventions//renovate/default"],
  "packageRules": [
    { "matchUpdateTypes": ["minor", "patch"], "matchDepTypes": ["devDependencies"], "groupName": "dev dependencies (non-major)" },
